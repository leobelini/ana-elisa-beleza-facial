---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage';
import heroSrc from '../assets/home/IMG_1455-Aprimorado-NR.jpg';
import aboutSrc from '../assets/home/IMG_5396-Enhanced-NR.jpg';
import servicesJson from '../data/services.json';
import { ADDRESS, COMPANY_INFO, CONTACT_INFO, OPENING_HOURS } from '../constants';
import { createSlug } from '../lib/slug';
import { getServiceImage, optimize } from '../lib/images';
import { collectStyles } from '../lib/ssr';

const title = 'Extensão de Cílios e Estética Facial em Pongaí-SP | Ana Elisa';
const description =
  'Extensão de cílios, design de sobrancelhas, limpeza de pele, lash lift e mais em Pongaí-SP. Agende com a Ana Elisa pelo WhatsApp.';

const services = await Promise.all(
  servicesJson.map(async (service) => ({
    ...service,
    slug: createSlug(service.title),
    image: await getServiceImage(service.images[0], 400, 200),
  })),
);

const props = {
  heroImage: await optimize(heroSrc, 400, 500),
  aboutImage: await optimize(aboutSrc, 300, 300),
  services,
};

const mapUrl = `https://maps.google.com/?q=${encodeURIComponent(
  `${ADDRESS.street}, ${ADDRESS.locality} - ${ADDRESS.region}, ${ADDRESS.postalCode}`,
)}`;
const businessId = `${COMPANY_INFO.siteUrl}/#negocio`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${COMPANY_INFO.siteUrl}/#website`,
      url: `${COMPANY_INFO.siteUrl}/`,
      name: COMPANY_INFO.name,
      inLanguage: 'pt-BR',
      publisher: { '@id': businessId },
    },
    {
      '@type': 'BeautySalon',
      '@id': businessId,
      name: COMPANY_INFO.name,
      description: COMPANY_INFO.description,
      url: `${COMPANY_INFO.siteUrl}/`,
      logo: COMPANY_INFO.logoUrl,
      image: COMPANY_INFO.logoUrl,
      hasMap: mapUrl,
      sameAs: [CONTACT_INFO.instagramUrl],
      founder: { '@type': 'Person', name: COMPANY_INFO.author },
      telephone: `+${CONTACT_INFO.whatsappNumber}`,
      priceRange: '$$',
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: OPENING_HOURS.days,
        opens: OPENING_HOURS.opens,
        closes: OPENING_HOURS.closes,
      },
      paymentAccepted: 'Dinheiro, Cartão de crédito, Cartão de débito, Pix',
      currenciesAccepted: 'BRL',
      address: {
        '@type': 'PostalAddress',
        streetAddress: ADDRESS.street,
        addressLocality: ADDRESS.locality,
        addressRegion: ADDRESS.region,
        postalCode: ADDRESS.postalCode,
        addressCountry: ADDRESS.country,
      },
      areaServed: { '@type': 'City', name: ADDRESS.locality },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços de Estética Facial',
        itemListElement: services.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service.title,
            description: service.shortDescription,
            url: `${COMPANY_INFO.siteUrl}/servicos/${service.slug}/`,
          },
        })),
      },
    },
  ],
};
---

<Layout title={title} description={description} styles={collectStyles(HomePage, props)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <HomePage client:load {...props} />
</Layout>

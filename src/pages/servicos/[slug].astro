---
import Layout from '../../layouts/Layout.astro';
import ServicePage from '../../components/ServicePage';
import servicesJson from '../../data/services.json';
import { COMPANY_INFO, generatePageTitle } from '../../constants';
import { createSlug } from '../../lib/slug';
import { getServiceImage } from '../../lib/images';
import { collectStyles } from '../../lib/ssr';

export function getStaticPaths() {
  return servicesJson.map((service) => ({
    params: { slug: createSlug(service.title) },
    props: { service },
  }));
}

const { service } = Astro.props;
const { slug } = Astro.params;

const props = {
  service,
  images: await Promise.all(service.images.map((path) => getServiceImage(path, 800, 600))),
};

const title = generatePageTitle(service.title);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.shortDescription,
  provider: {
    '@type': 'Organization',
    name: COMPANY_INFO.name,
    url: COMPANY_INFO.siteUrl,
  },
  category: service.category,
  offers: {
    '@type': 'Offer',
    description: `${service.title} - ${service.shortDescription}`,
  },
};
---

<Layout
  title={title}
  description={service.shortDescription}
  keywords={`${service.title}, ${service.category}, estética facial, beleza, ${service.title.toLowerCase()}`}
  url={`/servicos/${slug}`}
  styles={collectStyles(ServicePage, props)}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <ServicePage client:load {...props} />
</Layout>
